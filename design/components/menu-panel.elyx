    fill[0].linear-gradient.stops[1].color: rgb(12.16%, 43.53%, 54.51%),
    fill[0].linear-gradient.stops[0].color: rgb(5.88%, 16.47%, 26.67%)
  }
}

// Plain text button in the footer
export footerButton = frame {
  left: 160px,
  top: 500px,
  width: .auto,
  height: lengthTokens.lengths.row-height,
  layout: {align-items: .center},
  corner-radius: lengthTokens.lengths.row-radius,
  padding: [0px, lengthTokens.lengths.row-inset],
  children: buttonLabel,

  buttonLabel = text {
    fill: colorTokens.colors.primary,
    contents: "Quit",
    font-size: 13,
    font-family: "SF Pro"
  }
}

// MARK: Arrange card
// One suggestion: a thumbnail of the screen and its rank. Hovering shows outlines, resting on it tries it for real
export arrangeCard = frame {
  left: 40px,
  top: 600px,
  width: 144px,
  height: .auto,
  layout: {direction: .column, align-items: .center, item-gap: 6px},
  fill: colorTokens.colors.well-fill,
  corner-radius: lengthTokens.lengths.card-radius-small,
  padding: [8px, 8px, 6px],
  children: [thumbnail, rank],

  // 128 x 72, a 16:9 screen
  thumbnail = frame {
    width: 128px,
    height: 72px,
    children: [mainTile, topTile, bottomTile],

    mainTile = frame : thumbTile {
      left: 1.5px,
      top: 1.9px,
      width: 69px,
      height: 68.6px,

      thumbIcon {
        left: 22.5px,
        top: 22.3px
      }
    }

    topTile = frame : thumbTile {
      left: 73.5px,
      top: 1.9px,
      width: 53px,
      height: 33px,
      overrides: [insert(slackIcon, after = .nil), remove(thumbTile.thumbIcon)],

      slackIcon = frame : appIconSlack {
        left: 14.5px,
        top: 4.5px
      }
    }

    bottomTile = frame : thumbTile {
      left: 73.5px,
      top: 37.5px,
      width: 53px,
      height: 33px,
      overrides: [
        insert(terminalIcon, after = .nil),
        remove(thumbTile.thumbIcon)
      ],

      // Ghostty, with Messages stacked behind it: the window that didn't get a tile of its own
      terminalIcon = frame : stackIcons {
        left: 12px,
        top: 2px
      }
    }
  }

  rank = text {
    fill: colorTokens.colors.secondary,
    contents: "Best fit",
    font-size: 11,
    font-family: "SF Pro",
    font-style: "Semibold"
  }
}

// Hovered, or the one on screen right now
@variant
export arrangeCardTried = frame : arrangeCard {
  left: 216px,
  top: 600px,
  fill[0].color: colorTokens.colors.row-hover,

  rank {
    fill[0].color: colorTokens.colors.accent
  }

  thumbnail {
    bottomTile {
      border[0].color: colorTokens.colors.accent,
      fill[0].color: colorTokens.colors.tile-tried-fill
    }

    topTile {
      border[0].color: colorTokens.colors.accent,
      fill[0].color: colorTokens.colors.tile-tried-fill
    }

    mainTile {
      border[0].color: colorTokens.colors.accent,
      fill[0].color: colorTokens.colors.tile-tried-fill
    }
  }
}

