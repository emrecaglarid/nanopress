    height: 22px,
    opacity: 0.75
  }

  topIcon = frame : appIconTerminal {
    left: 0px,
    top: 7px,
    width: 22px,
    height: 22px
  }
}

export thumbTile = frame {
  left: 400px,
  top: 600px,
  width: 60px,
  height: 40px,
  fill: colorTokens.colors.tile-fill,
  border: colorTokens.colors.tile-border,
