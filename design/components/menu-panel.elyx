  tileName = text {
    fill: colorTokens.colors.secondary,
    contents: "Slack",
    font-size: 11,
    font-family: "SF Pro"
  }
}

// A stack: a tab bar along the top, like the one above the real stack. Click a tab to bring its window forward,
