import "../tokens/colors.elyx" as colorTokens
import "../tokens/lengths.elyx" as lengthTokens

// The parts of the menu panel. Mirrors Sources/AppBundle/ui/MenuPanel.swift and LayoutEditor.swift
// MARK: Menu bar icon
// The app icon's tiled screen with the landing tile filled. Drawn as a template image, so the menu bar tints it
export menuBarIcon = frame {
  left: 40px,
  top: 40px,
  width: 18px,
  height: 14px,
  children: [leftTile, topRightTile, landingTile],

  leftTile = frame {
    left: 0px,
    top: 0px,
    width: 9px,
    height: 14px,
    border: {color: colorTokens.colors.primary, width: 1.5px},
    corner-radius: 2.5px
  }

  topRightTile = frame {
    left: 9px,
    top: 0px,
    width: 9px,
    height: 7px,
    border: {color: colorTokens.colors.primary, width: 1.5px},
    corner-radius: 2.5px
  }

  landingTile = frame {
    left: 9px,
    top: 7.5px,
    width: 9px,
    height: 6.5px,
    fill: colorTokens.colors.primary,
    corner-radius: 2.5px
  }
}

// MARK: App icons
// Stand-ins for the real app icons, which the panel takes from each window's app
export appIcon = frame {
  left: 120px,
  top: 40px,
  width: 24px,
  height: 24px,
  fill: {
    linear-gradient: {
      angle: 180deg,
      stops: [
        stop(0%, rgb(36.08%, 61.18%, 100%)),
        stop(100%, rgb(14.9%, 38.82%, 92.16%))
      ]
    }
  },
  corner-radius: 6px,
  corner-smoothing: 0.6
}

@variant
export appIconSlack = frame : appIcon {
  left: 160px,
  top: 40px,
  fill[0].linear-gradient.stops[0].color: rgb(44.31%, 21.18%, 47.45%),
  fill[0].linear-gradient.stops[1].color: rgb(29.02%, 10.98%, 31.37%)
}

@variant
export appIconTerminal = frame : appIcon {
  left: 200px,
  top: 40px,
  fill[0].linear-gradient.stops[0].color: rgb(25.88%, 27.06%, 30.2%),
  fill[0].linear-gradient.stops[1].color: rgb(10.98%, 11.37%, 12.94%)
}

@variant
export appIconMessages = frame : appIcon {
  left: 240px,
  top: 40px,
  fill[0].linear-gradient.stops[0].color: rgb(40.39%, 87.06%, 43.53%),
  fill[0].linear-gradient.stops[1].color: rgb(14.9%, 72.94%, 25.88%)
}

// MARK: Controls
// The tiling switch in the header, controlSize .mini
export miniSwitch = frame {
  left: 320px,
  top: 40px,
  width: 26px,
  height: 15px,
  layout: {justify-content: .end, align-items: .center},
  fill: colorTokens.colors.accent,
  corner-radius: 100px,
  overflow: .visible,
  padding: 1.5px,
  children: knob,

  knob = frame {
    width: 12px,
    height: 12px,
    fill: colorTokens.colors.on-accent,
    shadow: {
      drop-shadow: {
        color: colorTokens.colors.shadow-far,
        offset: point(0px, 1px),
        blur-radius: 2px
      }
    },
    corner-radius: 100px
  }
}

// Section title with an optional quiet hint on the right
export sectionHeader = frame {
  left: 40px,
  top: 120px,
  width: 448px,
  height: .auto,
  layout: {justify-content: .space-between, align-items: .end},
  children: [sectionTitle, sectionDetail],

  sectionTitle = text {
    fill: colorTokens.colors.secondary,
    contents: "Arrange",
    font-size: 12,
    font-family: "SF Pro",
    font-style: "Semibold"
  }

  sectionDetail = text {
    fill: colorTokens.colors.tertiary,
    contents: "Hover to try, click to keep",
    font-size: 11,
    font-family: "SF Pro"
  }
}

// Number of windows on screen for Arrange
export countChip = frame {
  left: 560px,
  top: 200px,
  width: 28px,
  height: 24px,
  layout: {justify-content: .center, align-items: .center},
  fill: colorTokens.colors.well-fill,
  corner-radius: lengthTokens.lengths.row-radius,
  children: count,

  count = text {
    fill: colorTokens.colors.primary,
    contents: "2",
    font-size: 12,
    font-family: "SF Pro"
  }
}

@variant
export countChipSelected = frame : countChip {
  left: 600px,
  top: 200px,
  fill[0].color: colorTokens.colors.accent,

  count {
    fill[0].color: colorTokens.colors.on-accent,
    contents: "3",
    font-style: "Semibold"
  }
}

// Spacing picker, a segmented control
export segmentedControl = frame {
  left: 40px,
  top: 420px,
  width: 448px,
  height: 24px,
  layout: {align-items: .stretch},
  fill: colorTokens.colors.well-fill,
  corner-radius: lengthTokens.lengths.row-radius,
  overflow: .visible,
  padding: 2px,
  children: [none, small, medium, large],

  none = frame : segment {
    left: 0px,
    top: 0px,
    width: 25%,

    segmentLabel {
      contents: "None"
    }
  }

  small = frame : segment {
    left: 0px,
    top: 0px,
    width: 25%,

    segmentLabel {
      contents: "Small"
    }
  }

  medium = frame : segmentSelected {
    left: 0px,
    top: 0px,
    width: 25%
  }

  large = frame : segment {
    left: 0px,
    top: 0px,
    width: 25%,

    segmentLabel {
      contents: "Large"
    }
  }
}

export segment = frame {
  left: 560px,
  top: 420px,
  width: 110px,
  height: 20px,
  layout: {justify-content: .center, align-items: .center},
  corner-radius: 4px,
  children: segmentLabel,

  segmentLabel = text {
    fill: colorTokens.colors.primary,
    contents: "Small",
    font-size: 12,
    font-family: "SF Pro"
  }
}

@variant
export segmentSelected = frame : segment {
  left: 710px,
  top: 420px,
  fill[0].color: colorTokens.colors.segment-selected,
  shadow[0].drop-shadow.blur-radius: 2px,
  shadow[0].drop-shadow.color: colorTokens.colors.shadow-near,
  shadow[0].drop-shadow.offset: [0px, 1px],

  segmentLabel {
    contents: "Medium",
    font-style: "Medium"
  }
}

// One background. The selection ring sits 2px outside the swatch
export backgroundSwatch = frame {
  left: 40px,
  top: 500px,
  width: 28px,
  height: 28px,
  layout: {justify-content: .center, align-items: .center},
  corner-radius: 100px,
  children: swatch,

  swatch = frame {
    width: 24px,
    height: 24px,
    fill: rgb(10.98%, 10.98%, 11.76%),
    border: colorTokens.colors.separator,
    corner-radius: 100px
  }
}

@variant
export backgroundSwatchSelected = frame : backgroundSwatch {
  left: 88px,
  top: 500px,
  border[0].color: colorTokens.colors.accent,
  border[0].width: 2px,

  swatch {
    fill[0].linear-gradient.from: [50%, 0%],
    fill[0].linear-gradient.stops[1].position: 100%,
    fill[0].linear-gradient.stops[0].position: 0%,
