// MARK: Workspace strip
// A small map of one workspace with its name under it. Click to switch, drop a window on it to move the window there
export workspaceMini = frame {
  left: 40px,
  top: 1240px,
  width: 106px,
  height: .auto,
  layout: {direction: .column, align-items: .center, item-gap: 4px},
  children: [miniMap, miniName],

  // The shape of the workspace's screen
  miniMap = frame {
    width: 106px,
    height: 60px,
    fill: colorTokens.colors.well-fill,
    border: colorTokens.colors.separator,
    corner-radius: lengthTokens.lengths.row-radius,
    children: [miniLeftTile, miniRightTile],

    miniLeftTile = frame : thumbTile {
      left: 3px,
      top: 3px,
      width: 49px,
      height: 54px,
      overrides: [insert(miniDia, after = .nil), remove(thumbTile.thumbIcon)],

      miniDia = frame : appIcon {
        left: 16.5px,
        top: 19px,
        width: 16px,
        height: 16px,
        corner-radius: 4px
      }
    }

    miniRightTile = frame : thumbTile {
      left: 54px,
      top: 3px,
      width: 49px,
      height: 54px,
      overrides: [
        insert(miniMessages, after = .nil),
        remove(thumbTile.thumbIcon)
      ],

      miniMessages = frame : appIconMessages {
        left: 16.5px,
        top: 19px,
        width: 16px,
        height: 16px,
        corner-radius: 4px
      }
    }
  }

  miniName = text {
    fill: colorTokens.colors.secondary,
    contents: "2",
    font-size: 11,
    font-family: "SF Pro"
  }
}

