// The nanopress app icon: a tiled screen on a blue plate, one tile on its way into its slot, the way a dragged window
// moves. Render at 1024 x 1024 into resources/Assets.xcassets/AppIcon.appiconset/icon.png
appIcon = frame {
  left: 0px,
  top: 0px,
  width: 1024px,
  height: 1024px,
  children: plate,

  // macOS icon grid: an 824px plate centered on the 1024px canvas
  plate = frame {
    left: 100px,
    top: 100px,
    width: 824px,
    height: 824px,
    fill: {
      linear-gradient: {
        angle: 160deg,
        stops: [stop(0%, rgb(24%, 62%, 100%)), stop(100%, rgb(2%, 36%, 92%))]
      }
    },
    border: {color: rgb(100%, 100%, 100%, 20%), width: 2px},
    shadow: {
      drop-shadow: {
        color: rgb(0%, 20%, 60%, 40%),
        offset: point(0px, 12px),
        blur-radius: 24px
      }
    },
    corner-radius: 185px,
    corner-smoothing: 0.6,
    overflow: .visible,
    children: [leftTile, topRightTile, slot, movingTile],

    // The tiles at rest, a little see-through so that the moving one stands out
    leftTile = frame {
      left: 120px,
      top: 120px,
      width: 280px,
      height: 584px,
      fill: rgb(100%, 100%, 100%, 82%),
      corner-radius: 52px,
      corner-smoothing: 0.6
    }

    topRightTile = frame {
      left: 424px,
      top: 120px,
      width: 280px,
      height: 280px,
      fill: rgb(100%, 100%, 100%, 82%),
      corner-radius: 52px,
      corner-smoothing: 0.6
    }

    // Where the moving tile lands
    slot = frame {
      left: 424px,
      top: 424px,
      width: 280px,
      height: 280px,
      fill: rgb(100%, 100%, 100%, 12%),
      border: {
        color: rgb(100%, 100%, 100%, 85%),
        width: 8px,
        dash: [26px, 18px]
      },
      corner-radius: 52px,
      corner-smoothing: 0.6
    }

    // Lifted and tilted, coming in from the upper left
    movingTile = frame {
      left: 372px,
      top: 376px,
      width: 280px,
      height: 280px,
      transform: [0.985, -0.17, 0, 0.17, 0.985, 0],
      fill: .white,
      shadow: {
        drop-shadow: {
          color: rgb(0%, 12%, 45%, 50%),
          offset: point(0px, 28px),
          blur-radius: 44px
        }
      },
      corner-radius: 52px,
      corner-smoothing: 0.6
    }
  }
}
